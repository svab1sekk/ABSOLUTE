<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>ABSOLUTE</AssemblyName>
    <RootNamespace>Absolute.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/absolute.ico</ApplicationIcon>
    <Version>0.4.0</Version>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../Absolute.Core/Absolute.Core.csproj" /></ItemGroup>
  <ItemGroup><Resource Include="Assets/logo.png" Condition="Exists('Assets/logo.png')" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="Assets/gpu-pci.json.gz" LogicalName="Absolute.GpuPciIds" /></ItemGroup>
  <ItemGroup><Content Include="Dependencies/PawnIO_setup.exe" CopyToOutputDirectory="PreserveNewest" Condition="Exists('Dependencies/PawnIO_setup.exe')" /></ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.2" />
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="HidSharp" Version="2.6.4" />
    <PackageReference Include="System.IO.Pipes.AccessControl" Version="5.0.0" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="8.0.0" />
    <PackageReference Include="Vortice.Direct2D1" Version="3.6.2" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.6.2" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.6.2" />
  </ItemGroup>
</Project>
